# Local development uses Docker Compose Postgres (see docker-compose.yml).
# On the lanes DATABASE_URL is assembled from Secrets Manager values at task start (ARCHITECTURE.md §6).
DATABASE_URL=postgresql://seqtek:seqtek@localhost:5433/seqtek_dev

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace_me_with_a_32_byte_random_hex_value

# Content Security Policy mode: enforce | report-only | off
# Default is report-only so violations surface without breaking the page. Promote
# to enforce per INTEGRATIONS.md §8 "Rollout mechanism".
CSP_MODE=report-only

# OAuth — Google Workspace SSO for /admin (ADR 0002).
# Get values from the SEQTEK Google Cloud Console (OAuth 2.0 Client Credentials).
# Local dev: paste your dev client below. The lanes read
# /seqtek/website/preview/google_client_{id,secret} from Parameter Store
# (docs/INFRASTRUCTURE_RUNBOOK.md §4; every env var: docs/ARCHITECTURE.md §6).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HubSpot forms (INTEGRATIONS.md §1.2). Blank: forms render and run the full
# client-side lifecycle (validation, submitting, success, dataLayer events) but
# do NOT POST to HubSpot. The deploy sets all three as build args (deploy.yml);
# the portal ID and form GUIDs are public.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=
NEXT_PUBLIC_HUBSPOT_WORKSHOP_FORM_ID=

# LinkedIn Insight Tag partner ID (INTEGRATIONS.md §3). Blank: the tag never
# loads. Public; deploy.yml sets it.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
